      "html": "<style>\n    :root {\n    --bg-black: #07080a;\n    --panel-bg: #0d0f13;\n    --panel-border: rgba(255,255,255,0.08);\n    --text-primary: #f3f1ea;\n    --text-secondary: rgba(243,241,234,0.62);\n    --text-tertiary: rgba(243,241,234,0.4);\n    --control-bg: rgba(255,255,255,0.07);\n    --control-bg-hover: rgba(255,255,255,0.11);\n    --control-border: rgba(255,255,255,0.12);\n    --accent-teal: #37e0c4;\n    --accent-blue: #4a7bff;\n    --accent-violet: #8b6bff;\n    --accent-lime: #c7e35a;\n    --accent-coral: #ff8a65;\n    --font-serif: Georgia, 'Times New Roman', serif;\n    --font-sans: -apple-system, BlinkMacSystemFont, 'Segoe UI', Inter, Roboto, Helvetica, Arial, sans-serif;\n  }\n\n  * { box-sizing: border-box; }\n  html, body {\n    margin: 0;\n    padding: 0;\n    background: var(--bg-black);\n    color: var(--text-primary);\n    font-family: var(--font-sans);\n    height: 100%;\n    -webkit-font-smoothing: antialiased;\n  }\n\n  a { color: inherit; }\n\n  .page {\n    display: flex;\n    min-height: 100vh;\n    width: 100%;\n    overflow: hidden;\n    background: var(--bg-black);\n  }\n\n  /* ---------- LEFT PANEL ---------- */\n  .panel-left {\n    position: relative;\n    flex: 0 0 34%;\n    max-width: 620px;\n    min-width: 380px;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    padding: 48px 40px;\n    background:\n      radial-gradient(circle at 18% 8%, rgba(74,123,255,0.28), transparent 55%),\n      radial-gradient(circle at 85% 92%, rgba(139,107,255,0.22), transparent 60%),\n      var(--panel-bg);\n    border-right: 1px solid var(--panel-border);\n  }\n\n  .panel-left-inner {\n    width: 100%;\n    max-width: 360px;\n  }\n\n  .logo-row {\n    display: flex;\n    justify-content: center;\n    margin-bottom: 56px;\n  }\n\n  .logo-mark {\n    display: flex;\n    align-items: center;\n    gap: 8px;\n    font-family: var(--font-serif);\n    font-style: italic;\n    font-size: 26px;\n    letter-spacing: 0.5px;\n    color: var(--text-primary);\n  }\n\n  .logo-mark svg { flex-shrink: 0; }\n\n  h1.headline {\n    font-family: var(--font-serif);\n    font-weight: 400;\n    font-size: 34px;\n    line-height: 1.25;\n    text-align: center;\n    margin: 0 0 32px;\n    color: var(--text-primary);\n  }\n\n  .btn {\n    width: 100%;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    gap: 10px;\n    height: 48px;\n    border-radius: 10px;\n    font-size: 15px;\n    font-weight: 500;\n    font-family: var(--font-sans);\n    cursor: pointer;\n    border: 1px solid var(--control-border);\n    background: var(--control-bg);\n    color: var(--text-primary);\n    transition: background 0.15s ease, transform 0.1s ease;\n  }\n\n  .btn:hover { background: var(--control-bg-hover); }\n  .btn:active { transform: translateY(1px); }\n\n  .btn + .btn { margin-top: 14px; }\n\n  .btn svg { width: 18px; height: 18px; flex-shrink: 0; }\n\n  .divider {\n    display: flex;\n    align-items: center;\n    gap: 14px;\n    margin: 26px 0;\n  }\n\n  .divider::before,\n  .divider::after {\n    content: \"\";\n    flex: 1;\n    height: 1px;\n    background: var(--panel-border);\n  }\n\n  .divider span {\n    font-size: 12px;\n    letter-spacing: 1px;\n    color: var(--text-tertiary);\n  }\n\n  .field {\n    width: 100%;\n    height: 48px;\n    border-radius: 10px;\n    border: 1px solid var(--control-border);\n    background: var(--control-bg);\n    color: var(--text-primary);\n    font-size: 15px;\n    font-family: var(--font-sans);\n    padding: 0 16px;\n    margin-bottom: 14px;\n  }\n\n  .field::placeholder { color: var(--text-tertiary); }\n  .field:focus {\n    outline: none;\n    border-color: var(--accent-teal);\n    background: var(--control-bg-hover);\n  }\n\n  .btn-primary {\n    background: rgba(255,255,255,0.05);\n    color: var(--text-tertiary);\n    cursor: not-allowed;\n  }\n\n  .btn-primary.is-ready {\n    background: linear-gradient(135deg, var(--accent-teal), var(--accent-blue));\n    color: #06110e;\n    font-weight: 600;\n    cursor: pointer;\n  }\n\n  .link-new-account {\n    display: block;\n    text-align: center;\n    margin-top: 22px;\n    font-size: 14px;\n    color: var(--text-secondary);\n    text-decoration: none;\n  }\n\n  .link-new-account:hover { color: var(--text-primary); }\n\n  .legal {\n    margin-top: 18px;\n    font-size: 12px;\n    line-height: 1.6;\n    text-align: center;\n    color: var(--text-tertiary);\n  }\n\n  .legal a {\n    color: var(--text-secondary);\n    text-decoration: underline;\n  }\n\n  /* ---------- RIGHT PANEL ---------- */\n  .panel-right {\n    position: relative;\n    flex: 1;\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n    justify-content: center;\n    background: radial-gradient(circle at 50% 38%, #14161c 0%, #07080a 62%);\n    overflow: hidden;\n    padding: 40px;\n  }\n\n  .decor {\n    position: relative;\n    width: 420px;\n    height: 420px;\n    margin-bottom: 36px;\n  }\n\n  .shape {\n    position: absolute;\n  }\n\n  .badge-circle {\n    width: 260px;\n    height: 260px;\n    border-radius: 50%;\n    left: 50%;\n    top: 50%;\n    transform: translate(-50%, -50%);\n    background-image: url(\"https://kombai-assets.b-cdn.net/generated_assets/af378397-059f-4e75-8aae-2f7640d21df2/563a4abec3434c028156944b0ca3586f.jpg\");\n    background-size: cover;\n    background-position: center;\n    box-shadow: 0 0 70px rgba(55,224,196,0.18), inset 0 0 40px rgba(0,0,0,0.6);\n    display: flex;\n    align-items: center;\n    justify-content: center;\n  }\n\n  .badge-logo {\n    font-family: var(--font-serif);\n    font-style: italic;\n    font-size: 46px;\n    color: var(--text-primary);\n    letter-spacing: 0.5px;\n  }\n\n  .triangle {\n    width: 0;\n    height: 0;\n    border-left: 62px solid transparent;\n    border-right: 62px solid transparent;\n    border-bottom: 108px solid var(--accent-lime);\n    left: -18px;\n    top: 118px;\n    filter: drop-shadow(0 0 30px rgba(199,227,90,0.45));\n    opacity: 0.92;\n  }\n\n  .triangle::after {\n    content: \"\";\n    position: absolute;\n    top: 40px;\n    left: -46px;\n    width: 92px;\n    height: 60px;\n  }\n\n  .blob-face {\n    position: absolute;\n    border-radius: 45% 55% 60% 40% / 55% 45% 55% 45%;\n    background: linear-gradient(135deg, var(--accent-violet), #ff9ec4);\n    box-shadow: 0 0 34px rgba(139,107,255,0.35);\n  }\n\n  .blob-1 {\n    width: 150px;\n    height: 150px;\n    top: -16px;\n    right: 6px;\n    border-radius: 50% 50% 46% 54% / 58% 46% 54% 42%;\n  }\n\n  .blob-2 {\n    width: 130px;\n    height: 100px;\n    bottom: 66px;\n    left: -6px;\n    background: linear-gradient(135deg, var(--accent-coral), var(--accent-lime));\n    border-radius: 60% 40% 50% 50% / 60% 55% 45% 40%;\n  }\n\n  .quarter {\n    width: 130px;\n    height: 130px;\n    right: -14px;\n    bottom: 14px;\n    background: linear-gradient(135deg, #ff9d8a, var(--accent-coral));\n    border-radius: 0 100% 0 0;\n  }\n\n  .pentagon {\n    width: 62px;\n    height: 62px;\n    right: -8px;\n    top: 96px;\n    background: var(--accent-blue);\n    opacity: 0.85;\n    clip-path: polygon(50% 0%, 100% 38%, 82% 100%, 18% 100%, 0% 38%);\n  }\n\n  .square-outline {\n    width: 56px;\n    height: 56px;\n    left: 108px;\n    top: -6px;\n    border: 2px solid rgba(255,255,255,0.14);\n    border-radius: 8px;\n    transform: rotate(8deg);\n  }\n\n  .diamond-outline {\n    width: 60px;\n    height: 60px;\n    left: 26px;\n    bottom: 10px;\n    border: 2px solid rgba(255,255,255,0.1);\n    transform: rotate(45deg);\n  }\n\n  .face-line {\n    position: absolute;\n    border: 1px solid rgba(0,0,0,0.35);\n    border-radius: 50%;\n  }\n\n  .welcome {\n    text-align: center;\n    max-width: 420px;\n  }\n\n  .welcome h2 {\n    font-family: var(--font-sans);\n    font-weight: 700;\n    font-size: 20px;\n    margin: 0 0 10px;\n    color: var(--text-primary);\n  }\n\n  .welcome p {\n    font-size: 15px;\n    line-height: 1.6;\n    color: var(--text-secondary);\n    margin: 0;\n  }\n\n  .dots {\n    display: flex;\n    align-items: center;\n    gap: 16px;\n    margin-top: 36px;\n  }\n\n  .dot {\n    width: 12px;\n    height: 12px;\n    opacity: 0.35;\n  }\n\n  .dot-tri {\n    width: 0;\n    height: 0;\n    border-left: 6px solid transparent;\n    border-right: 6px solid transparent;\n    border-bottom: 11px solid var(--text-primary);\n  }\n\n  .dot-circle {\n    border-radius: 50%;\n    background: var(--text-primary);\n  }\n\n  .dot-square {\n    background: var(--text-primary);\n    border-radius: 2px;\n  }\n\n  .dot.active { opacity: 1; }\n\n  /* ---------- RESPONSIVE ---------- */\n  @media (max-width: 900px) {\n    .page { flex-direction: column; }\n    .panel-left {\n      flex: none;\n      max-width: 100%;\n      min-width: 0;\n      width: 100%;\n      border-right: none;\n      border-bottom: 1px solid var(--panel-border);\n      padding: 40px 24px;\n    }\n    .panel-right { padding: 48px 24px; }\n    .decor { width: 300px; height: 300px; margin-bottom: 24px; }\n    .badge-circle { width: 180px; height: 180px; }\n    .badge-logo { font-size: 32px; }\n  }\n\n  @media (max-width: 480px) {\n    h1.headline { font-size: 28px; }\n    .decor { width: 240px; height: 240px; }\n    .badge-circle { width: 150px; height: 150px; }\n    .badge-logo { font-size: 26px; }\n    .welcome p { font-size: 14px; }\n  }\n</style>\n<div class=\"page\" data-kid=\"6\" data-name=\"page layout container\">\n    <section class=\"panel-left\" data-kid=\"1\">\n        <div class=\"panel-left-inner\" data-kid=\"2\">\n            <div class=\"logo-row\" data-kid=\"3\">\n                <div class=\"logo-mark\" data-kid=\"4\">\n                    <svg data-kid=\"5\" fill=\"none\" height=\"22\" viewbox=\"0 0 24 24\" width=\"22\">\n                        <circle cx=\"12\" cy=\"12\" fill=\"url(#gradLogo)\" r=\"10\">\n                        </circle>\n                        <defs>\n                            <lineargradient gradientunits=\"userSpaceOnUse\" id=\"gradLogo\" x1=\"0\" x2=\"24\" y1=\"0\" y2=\"24\">\n                                <stop stop-color=\"#37e0c4\">\n                                </stop>\n                                <stop offset=\"1\" stop-color=\"#4a7bff\">\n                                </stop>\n                            </lineargradient>\n                        </defs>\n                    </svg>\n                    Verdant\n                </div>\n            </div>\n            <h1 class=\"headline\" data-kid=\"11\">\n                Sign in to Verdant\n            </h1>\n            <button class=\"btn btn-social\" data-kid=\"12\" type=\"button\">\n                <svg data-kid=\"13\" fill=\"currentColor\" viewbox=\"0 0 24 24\">\n                    <path d=\"M16.365 1.43c0 1.14-.417 2.06-1.25 2.86-.902.86-1.99 1.36-3.06 1.28-.11-1.1.4-2.15 1.24-2.9.86-.78 2.02-1.28 3.07-1.24zM20.6 17.14c-.44 1-.98 1.9-1.6 2.72-.86 1.14-1.72 2.28-3.08 2.3-1.34.02-1.78-.8-3.32-.8-1.53 0-2.02.78-3.28.82-1.32.04-2.32-1.24-3.2-2.36-1.75-2.28-3.1-6.44-1.3-9.26 1-1.65 2.77-2.7 4.7-2.72 1.28-.02 2.5.86 3.28.86.78 0 2.24-1.06 3.78-.9.64.03 2.45.26 3.6 1.94-.09.06-2.15 1.26-2.13 3.75.03 2.98 2.6 3.97 2.63 3.99z\">\n                    </path>\n                </svg>\n                Sign in with Apple\n            </button>\n            <button class=\"btn btn-social\" data-kid=\"15\" type=\"button\">\n                <svg data-kid=\"16\" viewbox=\"0 0 24 24\">\n                    <path d=\"M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z\" fill=\"#4a7bff\">\n                    </path>\n                    <path d=\"M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.99.66-2.25 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.85C3.99 20.53 7.7 23 12 23z\" fill=\"#37e0c4\">\n                    </path>\n                    <path d=\"M5.84 14.1c-.22-.66-.35-1.36-.35-2.1s.13-1.44.35-2.1V7.05H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.95l3.66-2.85z\" fill=\"#c7e35a\">\n                    </path>\n                    <path d=\"M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.05l3.66 2.85C6.71 7.3 9.14 5.38 12 5.38z\" fill=\"#ff8a65\">\n                    </path>\n                </svg>\n                Sign in with Google\n            </button>\n            <div class=\"divider\" data-kid=\"21\">\n                <span data-kid=\"22\">\n                    OR\n                </span>\n            </div>\n            <input class=\"field\" data-kid=\"23\" placeholder=\"Enter your email\" type=\"email\"/>\n            <button class=\"btn btn-primary\" data-kid=\"24\" disabled=\"\" type=\"button\">\n                Sign in with email\n            </button>\n            <a class=\"link-new-account\" data-kid=\"25\" href=\"#\">\n                I need a new account\n            </a>\n            <p class=\"legal\" data-kid=\"26\">\n                By continuing you agree to Verdant's\n                <a data-kid=\"27\" href=\"#\">\n                    Terms of Service\n                </a>\n                and\n                <a data-kid=\"28\" href=\"#\">\n                    Privacy Policy\n                </a>\n                .\n            </p>\n        </div>\n    </section>\n    <section class=\"panel-right\" data-kid=\"29\">\n        <div class=\"decor\" data-kid=\"30\">\n            <div class=\"shape square-outline\" data-kid=\"31\">\n            </div>\n            <div class=\"shape triangle\" data-kid=\"32\">\n            </div>\n            <div class=\"shape pentagon\" data-kid=\"33\">\n            </div>\n            <div class=\"shape blob-face blob-1\" data-kid=\"34\">\n            </div>\n            <div class=\"shape badge-circle\" data-kid=\"35\" data-name=\"badge container with background image\">\n                <span class=\"badge-logo\" data-kid=\"36\">\n                    V\n                </span>\n            </div>\n            <div class=\"shape blob-face blob-2\" data-kid=\"37\">\n            </div>\n            <div class=\"shape quarter\" data-kid=\"38\">\n            </div>\n            <div class=\"shape diamond-outline\" data-kid=\"39\">\n            </div>\n        </div>\n        <div class=\"welcome\" data-kid=\"40\">\n            <h2 data-kid=\"41\">\n                Welcome\n            </h2>\n            <p data-kid=\"42\">\n                Verdant is the simplest way to remember every person you meet — and what made them worth remembering.\n            </p>\n        </div>\n        <div class=\"dots\" data-kid=\"43\">\n            <span class=\"dot dot-tri\" data-kid=\"44\">\n            </span>\n            <span class=\"dot dot-circle active\" data-kid=\"45\">\n            </span>\n            <span class=\"dot dot-square\" data-kid=\"46\">\n            </span>\n        </div>\n    </section>\n</div>\n",
